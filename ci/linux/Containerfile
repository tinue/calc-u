# The Linux jobs of .github/workflows/calc-u-59.yml and calc-u-1600.yml
# in a container, to run before dispatching CI (ADR 0039; ci/linux/run.sh).
# Ubuntu 24.04 as on the runners: GCC 13.3, Qt 6.4 from apt.
#
# Mirrors, and changes with:
#   base  "Install build tools" (core-tests, library) and
#         "Install Qt6 + build tools" (linux-*) of both workflows
#   web   the web jobs' emsdk versions (setup-emsdk), Node (setup-node) and
#         the Playwright versions in the three package-lock.json files
# A change here rebuilds the image on the next run (run.sh labels the image
# with this file's hash).

FROM docker.io/library/ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build zlib1g-dev python3 patchelf \
      qt6-base-dev qt6-base-dev-tools qt6-multimedia-dev qt6-wayland libgl1-mesa-dev \
      qt6-gtk-platformtheme qt6ct \
      ccache rsync curl ca-certificates git zip xz-utils lsof \
    && rm -rf /var/lib/apt/lists/*
# ccache through CMake's launcher variables; the cache is a volume (run.sh).
ENV CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=5G
WORKDIR /work

FROM base AS web
# Node 24 (setup-node in both web jobs).
ARG NODE_VERSION=24.11.1
RUN arch=$(dpkg --print-architecture | sed 's/amd64/x64/') \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" \
       | tar -xJ -C /usr/local --strip-components=1
# The two products pin different Emscripten releases: 6.0.12 (Calc-U-59),
# 6.0.13 (Calc-U-1600). One emsdk each; jobs.sh sources the product's.
RUN for v in 6.0.12 6.0.13; do \
      git clone --depth 1 https://github.com/emscripten-core/emsdk.git /opt/emsdk-$v \
      && /opt/emsdk-$v/emsdk install $v && /opt/emsdk-$v/emsdk activate $v \
      && rm -rf /opt/emsdk-$v/downloads; \
    done
# Browsers and their system libraries for both locked Playwright versions;
# run-tests.sh's own `playwright install` then finds them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx -y playwright@1.65.0 install --with-deps chromium webkit \
    && npx -y playwright@1.64.1 install --with-deps chromium webkit \
    && rm -rf /var/lib/apt/lists/* /root/.npm
