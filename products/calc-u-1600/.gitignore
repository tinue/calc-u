# Output in the product folder (e.g. the Qt6 frontend's frontends/qt6/build/)
build/
build-tests/

# Scratch output of `calcu` runs (ROM/RAM dumps, traces, disassembly
# scratch, etc.) -- see headless/README.md. Everything under here is
# regenerable or disposable; only the README is tracked.
/headless/*
!/headless/README.md

# Debug trace captures dropped at the product root by an ad hoc run outside
# headless/ (see core/PC1500/PC1500TraceFile.hpp for the format) -- root only, other .bin under subdirectories is unaffected by this rule.
/*.bin

# Non-macOS libsharpdx binaries fetched by tools/fetch_sharpdx.sh (see
# the calcu_sharpdx target in CMakeLists.txt) -- unlike
# core/Basic/vendor/sharpdx/libsharpdx.a (macOS, committed, refreshed via
# tools/refresh_sharpdx.sh), these are meant to stay a local/CI-only build
# artifact, never committed.
/core/Basic/vendor/sharpdx/libsharpdx-linux.a
/core/Basic/vendor/sharpdx/*.lib
/core/Basic/vendor/sharpdx/native-libs-windows.txt

# sdas/zasm build output of the VS Code build tasks run on example sources
# (see help/07-debugger.md). The example .bin files are tracked, except
# memtest.bin: memtest.asm's own build, identical to memtest_stock.bin.
/examples/**/*.ihx
/examples/**/*.lnk
/examples/**/*.lst
/examples/**/*.map
/examples/**/*.rel
/examples/**/*.rst
/examples/**/*.sym
/dev/**/*.ihx
/dev/**/*.lnk
/dev/**/*.lst
/dev/**/*.map
/dev/**/*.rel
/dev/**/*.rst
/dev/**/*.sym
/examples/machine-code/memtest.bin
