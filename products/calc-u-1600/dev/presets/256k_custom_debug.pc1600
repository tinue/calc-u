# PC-1600 debug set for the 256K custom card in slot 2: formats and splits
# it (as its bundled contents were made), then shows the free memory and
# the RAM disk's size (Memory: 44602  Disk: 220160).
format-version: 2
model: PC-1600

slot-2: { name: 256K custom }

# init the card
keys:
  - key: mode
  - type: NEW0
  - type: INIT"S2:","F"
  - type: INIT"S2:","M"
  - type: X=MEM
  - type: Y=DSKF"S2:"
  - key: shift
  - key: cl
  - type: PRINT"Memory:";X;" Disk:";Y
