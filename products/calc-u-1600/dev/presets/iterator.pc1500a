# Debug the Up/Down key issue
format-version: 2
model: PC-1500A

keys:
  - key: cl
  - type: NEW0

program:
  text: |
    10 WAIT 10
    20 FOR I = 1 TO 100
    30 PRINT I
    40 NEXT I

keys:
  - key: mode
  - type: RUN
  - skip-wait:
  - wait: 2s
  - key: break
  - key: cl
  - key: mode
  - key: up
