# User-guide screenshots: the CE-1600P has just plotted the Lissajous demo
# (examples/plotter/lissajou-1600.bas).
format-version: 2
model: PC-1600
printer: CE-1600P
keys:
  - key: mode
  - type: NEW0
program:
  file: ../../../../examples/plotter/lissajou-1600.bas
keys:
  - key: mode
  - type: RUN
  - let-it-finish:
