# PC-1600 with a CE-1600M in slot 1 and the CE-1601M (64 KB = 2 x 32 KB
# vertical banks) in slot 2. Exercises trigger-based banking on OUT (28H)
# sampling the data bus, plus the PVOUT 16 KB half-select nested in the
# bank window.

format-version: 2
preset-name: Maximum memory
description: "CE-1600M and banked CE-1601M: as much memory as it gets"
model: PC-1600

slot-1: { name: CE-1600M }
slot-2: { name: CE-1601M }

# Both modules are expansion memory from the start (MEM 77370 without any
# INIT). The CE-1601M's second 32 KB becomes the RAM disk S2: only once
# the module is one: INIT "M" or "P" re-sizes a RAM disk the slot already
# holds (INIT, bank 3b 6464H), and on a fresh module it makes none, so
# every S2: file command gives ERROR 160. Hence "F" first (all 64 KB a
# RAM disk), then "M" (32 KB expansion memory, the rest the RAM disk).
keys:
  - key: mode
  - type: TITLE
  - type: INIT"S2:","F"
  - type: INIT"S2:","M"

program:
  text: |
    10 WAIT 0
    20 FOR I = 1 TO 100
    30 PRINT I
    40 NEXT I

keys:
  - type: SAVE"S2:LOOP.BAS"
  - type: NEW
  - key: mode
  - type: A=MEM
  - key: cl
  - type: PRINT"Memory:";A
  - type: FILES"S2:"
