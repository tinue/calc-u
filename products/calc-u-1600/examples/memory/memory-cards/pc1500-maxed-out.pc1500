# Loads the fictional 22 KB "maxed-out" card (pc1500-maxed-out.module.yaml,
# same directory) through the universal software-defined module, then
# prints how much of it BASIC sees as free. Companion to
# help/09-module-definitions.md's walkthrough.

format-version: 2
preset-name: Maxed-out card
description: A fictional 22 KB card, and how much BASIC sees
model: PC-1500

slot-1: { file: pc1500-maxed-out.module.yaml }

keys:
  - key: cl
  - type: PRINT"MEM =";MEM
  - wait: 2s
