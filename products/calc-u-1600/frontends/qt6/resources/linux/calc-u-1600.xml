<?xml version="1.0" encoding="UTF-8"?>
<!-- The presets' type that calc-u-1600.desktop names (MimeType=), installed
     into share/mime/packages (CalcU1600OpenWithTypes checks the list). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-calcu1600-preset">
    <comment>Calc-U-1600 Preset</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.pc1500"/>
    <glob pattern="*.pc1500a"/>
    <glob pattern="*.pc1600"/>
  </mime-type>
</mime-info>
