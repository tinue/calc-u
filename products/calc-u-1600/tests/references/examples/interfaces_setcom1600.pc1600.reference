│ ADTBL+1      │ F1D6 │ 00              │ Bank list: unused                                                  │
│ ADTBL+2      │ F1D7 │ 00              │ unused                                                             │
│ ADTBL+3      │ F1D8 │ 00              │ unused                                                             │
│ ADTBL+4      │ F1D9 │ 22              │ slot 2, bank 2                                                     │
│ ADTBL+5      │ F1DA │ 32              │ slot 2, bank 3                                                     │
