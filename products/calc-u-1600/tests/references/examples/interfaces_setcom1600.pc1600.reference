│ BASPRG_END   │ F867 │ 0192 → Z80 8192 │ S0 program end, the FFH mark (ADTBL index F02CH)                   │
│ EDITHEAD     │ F869 │ 0000 → Z80 8000 │ Edit / merge head                                                  │
│ PRGSTA       │ FE3C │ 80C5 [4]        │ Start of the TITLE area (PRGADR 02F4H)                             │
│ PRGENDA      │ FE3F │ 8192 [4]        │ End of the TITLE area                                              │
│ PROCPTR      │ FE00 │ FBB2            │ Interpreter: the next program byte (Z-80)                          │
│ CURTOP       │ F89E │ 00C5 → Z80 80C5 │ Block of the current line                                          │
│ LBCUR        │ F1C1 │ 04              │ ADTBL index of the current line                                    │
│ CURRENT_LINE │ F89C │ 0000 (0)        │ Current line number                                                │
│ SRCHLINE     │ F8A8 │ EE48 (61000)    │ Line after a SEARCH hit / last entered                             │
│ CONTADR      │ F0B9 │ 0000            │ CONT / restart address (Z-80)                                      │
│ TRON         │ F88D │ 00              │ TRON: off                                                          │
│ TRONMODE     │ F88E │ 02              │ TRON single-step state (1-4)                                       │
├──────────────┴──────┴─────────────────┴────────────────────────────────────────────────────────────────────┤
│ Errors and BREAK                                                                                           │
├──────────────┬──────┬─────────────────┬────────────────────────────────────────────────────────────────────┤
│ ERL          │ F89B │ 00              │ Last error number                                                  │
│ BRKADR       │ F8AC │ 0000 → Z80 8000 │ BREAK address                                                      │
│ BRKLINE      │ F8AE │ 0000 (0)        │ BREAK line                                                         │
│ ERRADR       │ F8B2 │ 0000 → Z80 8000 │ Error address                                                      │
│ ERRLINE      │ F8B4 │ 0000 (0)        │ Error line                                                         │
│ ONERADR      │ F8B8 │ 8000 (none)     │ ON ERROR GOTO target (bit 15 set: none)                            │
│ ONERLINE     │ F8BA │ 0000 (0)        │ ON ERROR line                                                      │
├──────────────┴──────┴─────────────────┴────────────────────────────────────────────────────────────────────┤
