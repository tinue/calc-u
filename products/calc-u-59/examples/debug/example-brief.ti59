format-version: 2
model: TI-59
# Load the Master Library
slot-1: { name: ML }
# Force Printer On
printer: PC-100C

# 800 steps, 19 data registers (R00–R19) — "2 OP 17"
partition: 799.19

# Program Listing
program:
  keycodes: |
    001 76 LBL
    002 11 A
    003 89 π
    004 95 =
    005 91 R/S

# Data Registers
data:
  00: 3.141592653589793  # π  (verify RCL 00 → 3.141592654)

# A cue card with one label
cue-card:
  title: Example
  A: Start

# Type some keys after load / reset
keys:
  - regular-speed:
  - key: 3
  - key: A
  - wait: 2s
  - key: RCL
  - key: 0
  - key: 0
