# example.ti59 — TI-59 preset validation example
# Demonstrates partition:, the two notations of program: (compact and listing), data: and a keys: section.
# Program: LBL A  *  π  =  R/S RST
# Running: press A with x=2 → should display 6.28618...  (2π)

format-version: 2
model: TI-59
description: TI-59 preset validation example
slot-1: { name: ML }
printer: PC-100C

partition: 799.19  # 800 steps, 19 data registers (R00–R19) — "2 OP 17"

program:
  keycodes: |
    # --- Compact: two-digit keycodes, from step 000 ---
    76 11  # LBL A
    # --- Listing: the step number places the keycode ---
    002 65  # x
    # --- Listing as the PC-100C prints it: the mnemonic is not read ---
    003 89 π
    004 95 =
    005 91 R/S
    006 81 RST
    # --- No gap marker: steps 007-109 are not listed and stay 00 ---
    # ...
    110 76 11  # LBL B (a second sub-routine at step 110)

data:
  00: 3.141592653589793  # π  (verify RCL 00 → 3.141592654)
  05: 7.77E22  # large positive  (verify RCL 05 → 7.77  22)
  12: -1.5e-3  # small negative  (verify RCL 12 → -0.0015)
  15: 0  # zero            (verify RCL 15 →  0.)

# The cue card
cue-card:
  title: Example
  A: Start

# The keys run the program, wait 2 seconds, show the three loaded registers, and then clear the display.
keys:
  - regular-speed:
  - key: 3
  - key: A
  - wait: 2s
  - key: RCL
  - key: 0
  - key: 0
  - wait: 1s
  - key: RCL
  - key: 0
  - key: 5
  - wait: 1s
  - key: RCL
  - key: 1
  - key: 2
  - wait: 1s
  - key: RCL
  - key: 1
  - key: 5
  - wait: 1s
  - key: CLR
