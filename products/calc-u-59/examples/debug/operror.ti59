# operror.ti59: Op 01 on a value recalled from a register.
#
# Expected: the display shows 1731371735 after RCL 15 Op 01, the same as
# after keying the digits in and Op 01.
#
# The `data:` value is converted to BCD by a correctly rounded %.12e
# conversion, so register 15 holds exactly 1731371735. A conversion that
# accumulates floating-point error would store 1731371734.999090: IDLE's
# display rounds it to ...735, but Op 01 shows the stored ...734. Keying
# the digits builds the register digit by digit and is exact either way.
# The traces operror.bin and opok.bin record both paths.

# model: TI-59

format-version: 2
model: TI-59
slot-1: { name: ML }
printer: PC-100C

data:
  15: 1731371735

keys:
  - regular-speed:
  - trace: operror.bin
  - key: RCL
  - key: 1
  - key: 5
  # 21  2nd
  - key: Op
  - key: 0
  - key: 1
  - trace: opok.bin
  - key: 1
  - key: 7
  - key: 3
  - key: 1
  - key: 3
  - key: 7
  - key: 1
  - key: 7
  - key: 3
  - key: 5
  # 21  2nd
  - key: Op
  - key: 0
  - key: 1
  - trace: off
