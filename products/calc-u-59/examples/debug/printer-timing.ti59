# Printer timing issues
#

format-version: 2
model: TI-59
slot-1: { name: ML }
printer: PC-100C

program:
  keycodes: |
    76 11 99 98 99 98 99 98 99 98 99 98 99 98 99 98 99 98 99 98 99 98 99 98 99 98 91
    76 12 98 98 98 91

keys:
  - regular-speed:
  # --- Via program first, regular speed ---
  - regular-speed:
  - key: CLR
  - elapsed-time: start
  - key: A
  - elapsed-time: report

  # --- Intra-test Adv ---
  - full-speed:
  - key: B

  # --- Via program, full speed ---
  - key: CLR
  - key: 8
  - key: 8
  - full-speed:
  - elapsed-time: start
  - key: A
  - elapsed-time: report

  # --- Intra-test Adv ---
  - full-speed:
  - key: B

  # --- Regular speed via keypress ---
  - regular-speed:
  - key: CLR
  - elapsed-time: start
  - key: Prt
  - key: Adv
  - key: Prt
  - key: Adv
  - key: Prt
  - elapsed-time: report

  # --- Intra-test Adv ---
  - full-speed:
  - key: B

  # --- Full speed via keypress ---
  - full-speed:
  - key: CLR
  - key: 8
  - key: 8
  - elapsed-time: start
  - key: Prt
  - regular-speed:
  - key: Adv
  - full-speed:
  - key: Prt
  - regular-speed:
  - key: Adv
  - full-speed:
  - key: Prt
  - elapsed-time: report
