# ret_bug_label.ti59 — a subroutine return address that must not get lost; use it to generate a trace
#
# The display shows "1" at the end.
#

format-version: 2
model: TI-59
description: Reproduce bug with lost return address, use to generate a trace
slot-1: { name: ML }
printer: PC-100C

program:
  keycodes: |
    000 76 LBL
    001 11 A
    002 01 1
    003 44 SUM
    004 00 00
    005 37 P/R
    008 43 RCL
    009 00 00
    010 91 R/S

# The cue card
cue-card:
  title: Regression test for SBR issue
  A: Start
