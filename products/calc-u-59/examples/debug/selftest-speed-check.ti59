# Self-test speed check.
#
# Runs the TI-59 ROM self-test (ML solid-state module, program 01 — the
# "2nd Pgm 01 SBR =" sequence) twice: once at regular speed, once at full
# speed, reporting the elapsed hardware-equivalent time for each via the
# steps elapsed-time: start and elapsed-time: report.
#
# Real hardware takes ~15s for SBR = on this self-test. Load this file and
# check the RUN LOG tab (DEBUG panel) for the two "Elapsed:" lines — both should
# be close to each other and to that ~15s figure.

format-version: 2
model: TI-59
slot-1: { name: ML }
printer: PC-100C

keys:
  - regular-speed:
  - key: Pgm
  - key: 0
  - key: 1  # → Pgm 01 selected
  - key: SBR
  - elapsed-time: start
  - key: =  # → run program 01 at regular speed
  - elapsed-time: report
  - full-speed:
  - key: SBR  # → re-enter program 01 (still selected)
  - elapsed-time: start
  - key: =  # → run program 01 again, at full speed
  - elapsed-time: report
