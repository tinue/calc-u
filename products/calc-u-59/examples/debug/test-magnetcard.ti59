# Test file for a cue card (2.3.0 drew it as a magnetic card; a preset's cue card is the plain card)

format-version: 2
model: TI-59
slot-1: { name: ML }
printer: PC-100C

data:
  00: 5000
  01: 8.5

cue-card:
  title: Interest Rate Calc
  A: Principal
  B: Rate
  C: Time
  D: Amount
  E: Interest
  "A'": Monthly
  "B'": Quarterly
  "C'": Semi-Annual
  "D'": Annual
  "E'": Compound
