# test_58c_display.ti58c
#
# Produces -1.2345678 × 10^-90 on the display — visually interesting
# because it fills the mantissa and shows a large negative exponent.
#
# Sequence: 1.2345678 +/- EE 90 +/-

format-version: 2
model: TI-58C
slot-1: { name: ML }
printer: PC-100C

cue-card:
  pencil-color: sharpie
  title: TI-58C Preset File Tutorial Cue Card
  row-1: Calculates the sum of 1..N the slow way
  row-1-align: left
  A: Sum 1..N
  C: Enter number, then A
  D: \blank
  E: \blank

keys:
  - regular-speed:
  - key: 1  # 1
  - key: .  # .
  - key: 2  # 2
  - key: 3  # 3
  - key: 4  # 4
  - key: 5  # 5
  - key: 6  # 6
  - key: 7  # 7
  - key: 8  # 8
  - key: +/-  # +/-
  - key: EE  # EE
  - key: 9  # 9
  - key: 0  # 0
  - key: +/-  # +/-
