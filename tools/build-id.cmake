# The build ID of a product: what its About and the version line of its
# Settings show in parentheses after the version.
#
#   <hash>        the commit; its CHANGELOG entry is dated (a release, and
#                 the release candidate it is promoted from)
#   pre-<hash>    the version's CHANGELOG entry is still "work in progress"
#                 (a pre-release, and a local build before the release)
#   <...>-dirty   the working tree has changes that are not committed
#
# "unknown" without git or outside a repository.
#
# The build time is the time of that commit in UTC ("2026-11-24T11:49:08Z"),
# so it changes only with the ID; empty without git.
#
#   cmake -DPRODUCT=<product directory> [-DOUT=<file> | -DHEADER=<file> | -DWHAT=time] -P tools/build-id.cmake
#
# Without OUT or HEADER it prints the ID (WHAT=time: the build time). OUT
# gets the ID alone, HEADER a C header defining APP_BUILD_ID and
# APP_BUILD_TIME; either is written only when it changes, so an unchanged
# build ID rebuilds nothing.

if(NOT DEFINED PRODUCT)
  message(FATAL_ERROR "build-id.cmake: -DPRODUCT=<product directory> is missing")
endif()

set(id unknown)
set(time "")
find_program(CALCU_GIT git)
if(CALCU_GIT)
  execute_process(COMMAND ${CALCU_GIT} -C ${PRODUCT} rev-parse --short HEAD
                  OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE result ERROR_QUIET)
  if(result EQUAL 0 AND NOT hash STREQUAL "")
    set(id ${hash})
    execute_process(COMMAND ${CMAKE_COMMAND} -E env TZ=UTC
                            ${CALCU_GIT} -C ${PRODUCT} log -1 --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ
                    OUTPUT_VARIABLE time OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(EXISTS ${PRODUCT}/CHANGELOG.md)
      file(STRINGS ${PRODUCT}/CHANGELOG.md entries REGEX "^## \\[")
      list(LENGTH entries count)
      if(count GREATER 0)
        list(GET entries 0 first)
        if(first MATCHES "work in progress")
          set(id pre-${id})
        endif()
      endif()
    endif()
    execute_process(COMMAND ${CALCU_GIT} -C ${PRODUCT} diff --quiet HEAD
                    RESULT_VARIABLE clean ERROR_QUIET)
    if(NOT clean EQUAL 0)
      set(id ${id}-dirty)
    endif()
  endif()
endif()

function(write_if_changed file content)
  if(EXISTS ${file})
    file(READ ${file} old)
    if(old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE ${file} "${content}")
endfunction()

if(DEFINED HEADER)
  write_if_changed(${HEADER} "#pragma once\n// Generated by tools/build-id.cmake at each build.\n#define APP_BUILD_ID \"${id}\"\n#define APP_BUILD_TIME \"${time}\"\n")
elseif(DEFINED OUT)
  write_if_changed(${OUT} "${id}\n")
elseif(WHAT STREQUAL "time")
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${time}")
else()
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo ${id})
endif()
