# The build ID of a product: what its About and the version line of its
# Settings show in parentheses after the version.
#
#   <hash>        the commit; its CHANGELOG entry is dated (a release, and
#                 the release candidate it is promoted from)
#   pre-<hash>    the version's CHANGELOG entry is still "work in progress"
#                 (a pre-release, and a local build before the release)
#   <...>-dirty   the working tree has changes that are not committed
#
# "unknown" without git or outside a repository.
#
#   cmake -DPRODUCT=<product directory> [-DOUT=<file> | -DHEADER=<file> [-DPACKAGE=<name>]]
#         [-DTIME_SOURCE=<file>] -P tools/build-id.cmake
#
# Without OUT, HEADER or TIME_SOURCE it prints the ID. OUT gets the ID alone, HEADER a C
# header defining APP_BUILD_ID and APP_PACKAGE (the package the build goes
# into: "DMG", "AppImage", "Windows installer" from the package jobs, else
# "self-built") and declaring calcuAppBuildTime(); either is written only
# when it changes, so an unchanged build ID rebuilds nothing.
#
# TIME_SOURCE gets the definition of calcuAppBuildTime(): the time of this
# build in UTC ("2026-11-24T12:01:37Z"). It is written at every build, so
# that one file compiles and the app links again each time.

if(NOT DEFINED PRODUCT)
  message(FATAL_ERROR "build-id.cmake: -DPRODUCT=<product directory> is missing")
endif()

set(id unknown)
find_program(CALCU_GIT git)
if(CALCU_GIT)
  execute_process(COMMAND ${CALCU_GIT} -C ${PRODUCT} rev-parse --short HEAD
                  OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE result ERROR_QUIET)
  if(result EQUAL 0 AND NOT hash STREQUAL "")
    set(id ${hash})
    if(EXISTS ${PRODUCT}/CHANGELOG.md)
      file(STRINGS ${PRODUCT}/CHANGELOG.md entries REGEX "^## \\[")
      list(LENGTH entries count)
      if(count GREATER 0)
        list(GET entries 0 first)
        if(first MATCHES "work in progress")
          set(id pre-${id})
        endif()
      endif()
    endif()
    execute_process(COMMAND ${CALCU_GIT} -C ${PRODUCT} diff --quiet HEAD
                    RESULT_VARIABLE clean ERROR_QUIET)
    if(NOT clean EQUAL 0)
      set(id ${id}-dirty)
    endif()
  endif()
endif()

function(write_if_changed file content)
  if(EXISTS ${file})
    file(READ ${file} old)
    if(old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE ${file} "${content}")
endfunction()

if(DEFINED HEADER)
  if(NOT PACKAGE)
    set(PACKAGE self-built)
  endif()
  write_if_changed(${HEADER} "#pragma once\n// Generated by tools/build-id.cmake at each build.\n#define APP_BUILD_ID \"${id}\"\n#define APP_PACKAGE \"${PACKAGE}\"\nconst char* calcuAppBuildTime();   // generated/BuildTime.cpp\n")
elseif(DEFINED OUT)
  write_if_changed(${OUT} "${id}\n")
elseif(NOT DEFINED TIME_SOURCE)
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo ${id})
endif()

if(DEFINED TIME_SOURCE)
  string(TIMESTAMP now "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(WRITE ${TIME_SOURCE} "// Generated by tools/build-id.cmake at each build.\nconst char* calcuAppBuildTime() { return \"${now}\"; }\n")
endif()
