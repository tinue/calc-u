#!/usr/bin/env python3
"""The help tool (LIB-16 AC-6; design §2.1).

  tools/help check <product>                         the checks, no asset
  tools/help build <product> [--version V] [--out D] the checks, then <Product>-help.zip

<product> is the product's name or short form, any case (Calc-U-1600,
calc-u-1600, 1600). Failures name the file and the line; warnings (the
glossary's "Avoid" words, AC-5) leave the exit status alone. Exit status:
0 without failures, 1 with, 2 for a usage error. Python 3, standard
library only.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from helptool import asset, checks, manifest  # noqa: E402


def main(argv):
    parser = argparse.ArgumentParser(prog="tools/help", description="Builds and checks a product's help (LIB-16).")
    parser.add_argument("command", choices=["build", "check"])
    parser.add_argument("product")
    parser.add_argument("--version", help="the asset's version (default: the product's, as ReleaseIt reads it)")
    parser.add_argument("--out", help="where the asset goes (default: build/help/ of the repository)")
    parser.add_argument("--root", help=argparse.SUPPRESS)  # the repository root; the tests' fixtures
    parser.add_argument("--quiet-warnings", action="store_true", help="count the warnings, do not list them")
    try:
        args = parser.parse_args(argv)
    except SystemExit as e:
        return 2 if e.code else 0
    root = Path(args.root) if args.root else Path(__file__).resolve().parent.parent
    try:
        help_ = manifest.load(root, args.product)
    except manifest.HelpError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2 if "no help for the product" in str(e) else 1
    report = checks.Report(root)
    _, used = checks.run(help_, report)
    version = None
    if args.command == "build" and not report.failures:
        try:
            version = args.version or help_.version()
        except manifest.HelpError as e:
            report.failures.append(str(e))
    if args.quiet_warnings:
        if report.warnings:
            print(f"{len(report.warnings)} warnings (the glossary's Avoid words; run without --quiet-warnings to list them)")
    else:
        for w in report.warnings:
            print(f"warning: {w}")
    for f in report.failures:
        print(f"error: {f}", file=sys.stderr)
    if report.failures:
        print(f"{help_.product}: {len(report.failures)} failures", file=sys.stderr)
        return 1
    if args.command == "build":
        out = Path(args.out) if args.out else root / "build" / "help"
        path = asset.build(help_, version, out, used)
        print(f"{help_.product} {version}: {path}")
    else:
        print(f"{help_.product}: the help passes its checks")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
